rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check ownership of resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles: Users can read and update only their own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
    }

    // Vendors: Anyone can read restaurant directory; vendors modify their own
    match /vendors/{vendorId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Food Menu items: Anyone can view active menu items
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Orders: Strict customer, kitchen, and courier isolation
    match /orders/{orderId} {
      // Customers read only their own orders; Kitchens read orders for their restaurant; Couriers read assigned orders
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        resource.data.courierId == request.auth.uid
      );
      
      // Customers can create orders with their own customerId
      allow create: if isAuthenticated() && 
        request.resource.data.customerId == request.auth.uid;
      
      // Order updates:
      // - Kitchen can advance order status (ACCEPTED, PREPARING, OUT_FOR_DELIVERY)
      // - Assigned Courier can update GPS coordinates and DELIVERED status
      // - Customer can cancel if order is still PENDING
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        resource.data.courierId == request.auth.uid
      );
    }
  }
}
